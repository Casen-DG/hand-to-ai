{
  "manifest_version": 3,
  "name": "交给 AI",
  "version": "0.3.2",
  "description": "Chat with your own AI assistant gateway in a side panel and hand it ONE browser tab at a time. Site access is requested for that one site only when you hand a tab over, and removed when you take it back.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "交给 AI (点击打开侧边栏)"
  },
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开「交给 AI」侧边栏"
    }
  }
}